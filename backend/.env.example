# --- Runtime ---
# "production" enables fail-fast checks (CORS, ENCRYPTION_KEY), disables /docs and turns on HSTS.
APP_ENV=development
LOG_LEVEL=INFO

# --- Security (required in production) ---
# Encrypts stored API keys and OAuth tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Comma-separated old keys that may still decrypt existing data during a key rotation.
ENCRYPTION_KEYS_PREVIOUS=
# Exact frontend origins allowed to call the API (no wildcards).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Frontend origin used for the Google OAuth return URL.
FRONTEND_URL=http://localhost:3000

# --- Authentication (Supabase) ---
# Tokens are verified against ${SUPABASE_URL}/auth/v1/.well-known/jwks.json (ES256/RS256).
SUPABASE_URL=https://your-project.supabase.co
# Only for legacy projects that still sign with the shared HS256 secret.
SUPABASE_JWT_SECRET=

# --- Database ---
# Postgres (use the session pooler on :5432 for migrations; :6543 transaction pooler is supported):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./seo_audit.db
REDIS_URL=redis://localhost:6379/0

# --- Crawler ---
MAX_CRAWL_PAGES=1000
CRAWLER_USER_AGENT=AuditProBot/1.0 (+https://auditpro.ai/bot)
# Development only: allow auditing localhost / private-network sites. Never enable in production.
ALLOW_PRIVATE_NETWORK_FETCH=false

# --- Optional platform API keys (used only when a workspace has not connected its own) ---
GEMINI_API_KEY=
PAGESPEED_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
SERPAPI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Crawl queue and worker ---
# inline (default): the API process runs crawls (development, single service).
# worker: the API only queues crawls; `python -m app.worker` (the "worker" service) runs them.
# Use the same value on the API and the worker. See docs/DEPLOY_COOLIFY.md before switching.
CRAWL_RUNNER=inline
# Crawls running at once (per API in inline mode, per worker in worker mode). KVM 4: 3 + 1; KVM 2: 2 + 1.
CRAWL_SLOTS=3
JS_CRAWL_SLOTS=1
# Worker tuning (defaults shown). Grace must stay below the container stop timeout (compose: 120 s).
WORKER_GRACE_SECONDS=100
WORKER_MAX_MEMORY_PCT=75
WORKER_HEARTBEAT_SECONDS=15
WORKER_STALE_SECONDS=180
STUCK_CRAWL_HOURS=2
WORKER_HEALTH_FILE=/tmp/worker-heartbeat

# --- Alerts ---
# Slack / Discord (or any {"text": ...} webhook) for one grouped alert per crawl with problems. Empty = log only.
ALERT_WEBHOOK_URL=

# --- Deploy (containers only) ---
# true on the API service: run `alembic upgrade head` (advisory-locked) before starting. Never on the worker.
RUN_MIGRATIONS=false
# One-time: Alembic revision to stamp an existing database that has tables but no alembic_version.
MIGRATIONS_BASELINE=
