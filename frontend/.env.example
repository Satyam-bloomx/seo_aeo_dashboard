# Copy to .env.local for development. All NEXT_PUBLIC_* values are embedded in the browser bundle.
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable (anon) key: safe in the browser only while Row Level Security is enabled on every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
